# Copy this file to .env.local (same directory) and fill in only the keys
# you actually need. .env.local is git-ignored — config.yaml is NOT, which
# is why keys live here instead of there.
#
# Loaded automatically on startup (see config.py:_load_dotenv_local). A
# value already set in your real shell environment always wins over this
# file.

ANTHROPIC_API_KEY=
COMMANDCODE_API_KEY=
DEEPSEEK_API_KEY=
OPENROUTER_API_KEY=

# lmarena2api (self-hosted) — see https://github.com/deanxv/lmarena2api
# LMARENA_API_KEY is the API_SECRET you set when starting that server.
# LMARENA_BASE_URL only needs setting if you're not using the default
# http://localhost:10088/v1 (e.g. a different port or a remote host).
LMARENA_API_KEY=
LMARENA_BASE_URL=

# Custom OpenAI-compatible endpoint (used when custom_model_url is set
# in config.yaml)
CUSTOM_MODEL_KEY=
