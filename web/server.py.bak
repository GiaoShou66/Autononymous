"""
Web Panel Backend Server
Connects the modern web UI to the AI agent
"""

from flask import Flask, request, jsonify, send_from_directory, Response
from flask_cors import CORS
import sys
import os
from pathlib import Path
import json
import time
from threading import Thread
from queue import Queue

# Add parent directory to path to import agent modules
sys.path.insert(0, str(Path(__file__).parent.parent))

from agent import Agent
from config import load_config
from models import ModelClient
from skills import SkillRegistry
from tools import ProjectTools
from memory import AgentMemory
from autonomous import AutonomousAgent, AutonomousConfig
from mcp_client import MCPClientManager
from hooks import HookManager

app = Flask(__name__, static_folder='.', static_url_path='')
CORS(app)

# Global agent instance
agent = None
autonomous = None
cfg = None

def initialize_agent():
    """Initialize the AI agent"""
    global agent, autonomous, cfg
    
    cfg = load_config()
    
    tools = ProjectTools(
        project_root=cfg.project_root,
        command_timeout=cfg.command_timeout,
        include_ignored_files=cfg.include_ignored_files,
    )
    
    model_client = ModelClient(model_name=cfg.model_name)
    skill_registry = SkillRegistry(cfg.skills_root) if cfg.skills_root else None
    
    memory_path = cfg.memory_path or (cfg.project_root / ".agent_memory.json")
    agent_memory = AgentMemory.load(memory_path, max_lessons=cfg.memory_max_lessons)
    
    settings_path = cfg.project_root / ".agent" / "settings.json"
    if settings_path.exists():
        with open(settings_path) as f:
            settings = json.load(f)
    else:
        settings = {"hooks": []}
    
    hook_manager = HookManager(settings["hooks"], cfg.project_root)
    
    agent = Agent(
        model=model_client,
        tools=tools,
        skills=skill_registry,
        mode=cfg.mode,
        max_context_turns=cfg.max_context_turns,
        max_iterations=cfg.max_iterations,
        max_auto_skills=cfg.max_auto_skills,
        skill_prompt_chars=cfg.skill_prompt_chars,
        mcp=MCPClientManager(cfg.mcp_servers, timeout=cfg.request_timeout),
        memory=agent_memory,
        compact_threshold=cfg.compact_threshold,
        hooks=hook_manager,
    )
    
    # Initialize autonomous agent
    autonomous_config = AutonomousConfig(
        enable_auto_continuation=True,
        enable_iteration=True,
        enable_loops=True,
        enable_task_decomposition=True,
        enable_self_correction=True,
        enable_streaming=True,
    )
    autonomous = AutonomousAgent(agent, autonomous_config)
    
    print(f"✓ Agent initialized with model: {cfg.model_name}")
    print(f"✓ Project root: {cfg.project_root}")
    print(f"✓ Mode: {cfg.mode}")

@app.route('/')
def index():
    """Serve the main HTML page"""
    return send_from_directory('.', 'index.html')

@app.route('/<path:path>')
def serve_static(path):
    """Serve static files"""
    try:
        return send_from_directory('.', path)
    except Exception as e:
        print(f"Error serving {path}: {e}")
        return f"File not found: {path}", 404

@app.route('/api/chat', methods=['POST'])
def chat():
    """Handle chat requests"""
    global agent
    
    try:
        data = request.json
        message = data.get('message', '')
        mode = data.get('mode', 'claude-code')
        history = data.get('history', [])
        settings = data.get('settings', {})
        
        if not message:
            return jsonify({'error': 'No message provided'}), 400
        
        # Switch mode if needed
        if mode != agent.mode:
            agent.set_mode(mode)
        
        # Get response from agent
        try:
            response = agent.ask(message)
        except Exception as agent_error:
            print(f"Agent error: {agent_error}")
            import traceback
            traceback.print_exc()
            response = f"Sorry, I encountered an error: {str(agent_error)}"
        
        return jsonify({
            'response': response,
            'mode': agent.mode,
            'timestamp': time.time(),
        })
    
    except Exception as e:
        print(f"Error in chat: {e}")
        import traceback
        traceback.print_exc()
        return jsonify({'error': str(e)}), 500

@app.route('/api/chat/stream', methods=['POST'])
def chat_stream():
    """Handle streaming chat requests"""
    global agent
    
    try:
        data = request.json
        message = data.get('message', '')
        mode = data.get('mode', 'claude-code')
        
        if not message:
            return jsonify({'error': 'No message provided'}), 400
        
        # Switch mode if needed
        if mode != agent.mode:
            agent.set_mode(mode)
        
        def generate():
            """Generator for SSE streaming"""
            try:
                # Send start event
                yield f"data: {json.dumps({'type': 'start'})}\n\n"
                
                # Get streaming response
                if hasattr(agent.model, 'chat_stream'):
                    try:
                        messages = agent._messages_for_model([])
                        messages.append({"role": "user", "content": message})
                        
                        full_response = ""
                        for chunk in agent.model.chat_stream(messages):
                            if chunk:  # Only send non-empty chunks
                                full_response += chunk
                                event_data = json.dumps({
                                    'type': 'chunk',
                                    'content': chunk
                                })
                                yield f"data: {event_data}\n\n"
                    except Exception as stream_error:
                        print(f"Streaming error: {stream_error}")
                        # Fall back to non-streaming
                        response = agent.ask(message)
                        for i in range(0, len(response), 50):
                            chunk = response[i:i+50]
                            event_data = json.dumps({
                                'type': 'chunk',
                                'content': chunk
                            })
                            yield f"data: {event_data}\n\n"
                            time.sleep(0.05)
                else:
                    # Fallback: get full response and simulate streaming
                    response = agent.ask(message)
                    for i in range(0, len(response), 50):
                        chunk = response[i:i+50]
                        event_data = json.dumps({
                            'type': 'chunk',
                            'content': chunk
                        })
                        yield f"data: {event_data}\n\n"
                        time.sleep(0.05)
                
                # Send end event
                yield f"data: {json.dumps({'type': 'end'})}\n\n"
                
            except GeneratorExit:
                # Client disconnected
                print("Client disconnected from stream")
            except Exception as gen_error:
                print(f"Generator error: {gen_error}")
                error_data = json.dumps({
                    'type': 'error',
                    'message': str(gen_error)
                })
                yield f"data: {error_data}\n\n"
        
        response = Response(generate(), mimetype='text/event-stream')
        response.headers['Cache-Control'] = 'no-cache'
        response.headers['X-Accel-Buffering'] = 'no'
        return response
    
    except Exception as e:
        print(f"Error in chat_stream: {e}")
        import traceback
        traceback.print_exc()
        return jsonify({'error': str(e)}), 500

@app.route('/api/autonomous/<command>', methods=['POST'])
def autonomous_command(command):
    """Handle autonomous commands"""
    global autonomous
    
    try:
        data = request.json
        task = data.get('task', '')
        
        if not task:
            return jsonify({'error': 'No task provided'}), 400
        
        if command == 'continuous':
            progress = []
            
            def on_progress(msg):
                progress.append(msg)
            
            result = autonomous.continuous_code(task, on_progress=on_progress)
            
            return jsonify({
                'result': result,
                'progress': progress,
            })
        
        elif command == 'iterate':
            iterations = []
            
            def on_iteration(iteration, result, score):
                iterations.append({
                    'iteration': iteration,
                    'score': score,
                    'length': len(result),
                })
            
            result = autonomous.iterative_generate(task, on_iteration=on_iteration)
            
            return jsonify({
                'result': result,
                'iterations': iterations,
            })
        
        elif command == 'decompose':
            completed_tasks = []
            
            def on_task_complete(task_obj):
                completed_tasks.append({
                    'id': task_obj.id,
                    'description': task_obj.description,
                    'status': task_obj.status.value,
                })
            
            result = autonomous.decompose_and_execute(task, on_task_complete=on_task_complete)
            
            return jsonify({
                'result': result['summary'],
                'tasks': completed_tasks,
            })
        
        else:
            return jsonify({'error': f'Unknown command: {command}'}), 400
    
    except Exception as e:
        print(f"Error in autonomous command: {e}")
        return jsonify({'error': str(e)}), 500

@app.route('/api/modes', methods=['GET'])
def get_modes():
    """Get available agent modes"""
    global agent
    
    try:
        return jsonify({
            'modes': agent.available_modes(),
            'current': agent.mode,
        })
    except Exception as e:
        return jsonify({'error': str(e)}), 500

@app.route('/api/mode', methods=['POST'])
def set_mode():
    """Set agent mode"""
    global agent
    
    try:
        data = request.json
        mode = data.get('mode')
        
        if not mode:
            return jsonify({'error': 'No mode provided'}), 400
        
        agent.set_mode(mode)
        
        return jsonify({
            'mode': agent.mode,
            'success': True,
        })
    except Exception as e:
        return jsonify({'error': str(e)}), 500

@app.route('/api/skills', methods=['GET'])
def get_skills():
    """Get available skills"""
    global agent
    
    try:
        if not agent.skills:
            return jsonify({'skills': []})
        
        skills = [
            {
                'name': skill.name,
                'description': skill.description,
                'keywords': skill.keywords,
            }
            for skill in agent.skills.all()
        ]
        
        return jsonify({'skills': skills})
    except Exception as e:
        return jsonify({'error': str(e)}), 500

@app.route('/api/memory', methods=['GET'])
def get_memory():
    """Get agent memory"""
    global agent
    
    try:
        return jsonify({
            'lessons': agent.memory.lessons,
            'rolling_summary': agent.memory.rolling_summary,
        })
    except Exception as e:
        return jsonify({'error': str(e)}), 500

@app.route('/api/changes', methods=['GET'])
def get_changes():
    """Get file changes made by agent"""
    global agent
    
    try:
        changes = [
            {
                'action': entry.action,
                'path': entry.path,
                'details': entry.details,
                'timestamp': entry.timestamp,
            }
            for entry in agent.tools.changes.entries
        ]
        
        return jsonify({'changes': changes})
    except Exception as e:
        return jsonify({'error': str(e)}), 500

@app.route('/api/health', methods=['GET'])
def health():
    """Health check endpoint"""
    return jsonify({
        'status': 'ok',
        'agent_initialized': agent is not None,
        'model': cfg.model_name if cfg else None,
        'mode': agent.mode if agent else None,
    })

@app.route('/api/models', methods=['GET'])
def get_models():
    """Get available models"""
    global agent
    
    try:
        if hasattr(agent.model, 'list_available_models'):
            models = agent.model.list_available_models()
        else:
            models = [cfg.model_name]
        
        return jsonify({
            'models': models,
            'current': cfg.model_name,
        })
    except Exception as e:
        return jsonify({'error': str(e)}), 500

@app.route('/api/config', methods=['GET'])
def get_config():
    """Get current configuration"""
    global cfg
    
    try:
        return jsonify({
            'model': cfg.model_name,
            'mode': cfg.mode,
            'max_iterations': cfg.max_iterations,
            'max_context_turns': cfg.max_context_turns,
            'project_root': str(cfg.project_root),
        })
    except Exception as e:
        return jsonify({'error': str(e)}), 500

def main():
    """Main entry point"""
    print("=" * 60)
    print("AI Agent Web Panel")
    print("=" * 60)
    
    # Initialize agent
    print("\nInitializing agent...")
    initialize_agent()
    
    # Start server
    print("\n" + "=" * 60)
    print("Server starting...")
    print(f"Web Panel: http://localhost:5000")
    print(f"API: http://localhost:5000/api")
    print("=" * 60)
    print("\nPress Ctrl+C to stop\n")
    
    app.run(host='0.0.0.0', port=5000, debug=False, threaded=True)

if __name__ == '__main__':
    main()
